{
    "$schema":  "node_modules/wrangler/config-schema.json",
    "name":  "tracker-platform",
    "main":  "../server/index.ts",
    "compatibility_date":  "2026-03-10",
    "compatibility_flags":  [
                                "nodejs_compat"
                            ],
    "observability":  {
                          "enabled":  true
                      },
    "triggers":  {
                       "crons":  []
                   },
    "kv_namespaces":  [
                          {
                              "binding":  "P2P_KV",
                              "id":  "00e9cb0899964d34a89b8b41376682ed"
                          }
                      ],
    "d1_databases":  [
                         {
                             "binding":  "DB",
                             "database_name":  "tracker-platform",
                             "database_id":  "9b53d6c4-d67e-4dce-90fb-57b64cf95653",
                             "migrations_dir":  "d1/migrations"
                         }
                     ],
    "vars":  {
                 "APP_ENV":  "development",
                 "ALLOWED_ORIGINS":  "*",
                 "AUTH_SOURCE":  "cloudflare-access",
                 "P2P_LIVE_PROVIDER_URL":  "https://p2p-tracker-api.taheito26.workers.dev/api/p2p"
             },
    "assets":  {
                   "directory":  "../dist",
                   "not_found_handling":  "single-page-application"
               }
}
